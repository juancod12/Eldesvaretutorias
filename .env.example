# ============================================
# EL DESVARE - Variables de Entorno
# Copia este archivo como .env y configura
# ============================================

# Puerto del servidor
PORT=3000

# ---- CORREO --------------------------------
# Correo donde llegan las solicitudes
BUSINESS_EMAIL=tu_correo@gmail.com

# SMTP (Gmail: smtp.gmail.com / Puerto 587)
# Para Gmail necesitas una "Contraseña de aplicación"
# Ver README para instrucciones detalladas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion

# Nombre del remitente en los correos
EMAIL_FROM_NAME=El Desvare

# ---- WHATSAPP CLOUD API --------------------
# Obtenidos desde Meta for Developers
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número de destino (del negocio, con código de país sin +)
# Ejemplo Colombia: 573001234567
WHATSAPP_BUSINESS_NUMBER=57XXXXXXXXXX
WHATSAPP_API_VERSION=v21.0

# Nombre de la plantilla aprobada en Meta
# Ver README > Configurar WhatsApp
WHATSAPP_TEMPLATE_NAME=nueva_solicitud_cotizacion

# ---- MODO DESARROLLO -----------------------
# true = simula WhatsApp sin llamar a Meta (para desarrollo)
# false = usa la API real de Meta (producción)
WHATSAPP_MOCK_MODE=true

# ---- ARCHIVOS ------------------------------
# Tamaño máximo por archivo en bytes (10MB = 10485760)
UPLOAD_MAX_SIZE=10485760

# ---- CONTACTO NEGOCIO ----------------------
# Número de WhatsApp del negocio para el botón de contacto directo
BUSINESS_WHATSAPP=57XXXXXXXXXX

# URL del sitio en producción (para links en correos)
SITE_URL=http://localhost:3000
