# ============================================
# EL DESVARE - Variables de Entorno
# Copia este archivo como .env y configura
# ============================================

# Puerto del servidor
PORT=3000

# ---- CORREO (Resend) ------------------------
# Correo donde llegan las solicitudes (debe ser el mismo con el que
# te registraste en Resend si no tienes un dominio verificado ahí)
BUSINESS_EMAIL=asesoriaseldesvare@gmail.com

# API key de Resend (dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Sin dominio verificado en Resend debe quedar
# onboarding@resend.dev (solo puede enviar a BUSINESS_EMAIL en ese caso).
# Con un dominio propio verificado, usa algo como notificaciones@tudominio.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Nombre del remitente en los correos
EMAIL_FROM_NAME=El Desvare

# ---- WHATSAPP CLOUD API --------------------
# Obtenidos desde Meta for Developers
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número de destino (del negocio, con código de país sin +)
# Ejemplo Colombia: 573001234567
WHATSAPP_BUSINESS_NUMBER=573044168961
WHATSAPP_API_VERSION=v21.0

# Nombre de la plantilla aprobada en Meta
# Ver README > Configurar WhatsApp
WHATSAPP_TEMPLATE_NAME=nueva_solicitud_cotizacion

# ---- MODO DESARROLLO -----------------------
# true = simula WhatsApp sin llamar a Meta (para desarrollo)
# false = usa la API real de Meta (producción)
WHATSAPP_MOCK_MODE=true

# ---- ARCHIVOS ------------------------------
# El correo es el único canal de entrega (no hay base de datos ni storage
# externo). Gmail rechaza correos de más de ~25MB ya codificados, y la
# codificación base64 de los adjuntos añade ~33% de peso — por eso el tope
# seguro es 18MB en crudo.
# Tamaño máximo por archivo, en bytes (18MB = 18874368)
UPLOAD_MAX_SIZE=18874368
# Tamaño máximo combinado de todos los archivos de una solicitud, en bytes
UPLOAD_MAX_TOTAL_SIZE=18874368

# ---- CONTACTO NEGOCIO ----------------------
# Número de WhatsApp del negocio para el botón de contacto directo
BUSINESS_WHATSAPP=573044168961

# URL del sitio en producción (para links en correos)
SITE_URL=http://localhost:3000
